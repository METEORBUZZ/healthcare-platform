NODE_ENV=development
PORT=4000
PUBLIC_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare
DATABASE_SSL=disable
# Used by Docker Compose only; generate a URL-safe password with: openssl rand -hex 32
POSTGRES_PASSWORD=
# Generate a unique value with: openssl rand -base64 48
JWT_ACCESS_SECRET=
# Optional additional trusted origins; public/admin origins are always included.
CORS_ORIGINS=
COOKIE_SECURE=false
CLINIC_TIMEZONE=Asia/Kolkata
# Local development only; required only when running the demo seed script.
SEED_PASSWORD=
