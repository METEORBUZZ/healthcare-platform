{
  "name": "healthcare-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HealthCare+ — appointment booking platform for patients, doctors and administrators",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @healthcare/api\" \"npm run dev -w @healthcare/web\"",
    "build": "npm run build -w @healthcare/api && npm run build -w @healthcare/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "npm run db:migrate -w @healthcare/api",
    "db:seed": "npm run db:seed -w @healthcare/api",
    "db:reset": "npm run db:seed -w @healthcare/api -- --reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
